# Shell scripts must keep LF endings or bash fails with $'\r' errors when
# they are edited on the Windows side of the WSL2 mount.
*.sh text eol=lf
*.yml text eol=lf
*.py text eol=lf

# Makefiles, their includes and the help script: LF everywhere. A CRLF recipe
# line passes a stray \r to the shell.
Makefile text eol=lf
*.mk text eol=lf
*.awk text eol=lf
