# Copy to `.env` (git-ignored) and fill in. Never commit real keys.
#
# Every name below is taken from an os.getenv() call in this folder's scripts.

# --- Gemini datasheet extraction -------------------------------------------
# gemini_mosfet_data_extractor.py, check_models.py
GEMINI_API_KEY=

# Optional extra keys for the rotation engine in gemini_mosfet_data_extractor.py.
# It scans GEMINI_API_KEY_MOSFET_SCRAPPER_3 .. _51 and rotates through whichever
# are set, to spread free-tier rate limits. Leave unset to run on one key.
# GEMINI_API_KEY_MOSFET_SCRAPPER_3=
# GEMINI_API_KEY_MOSFET_SCRAPPER_4=

# --- DigiKey product search API --------------------------------------------
# digikey_mosScraper.py
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=

# --- Mouser search API ------------------------------------------------------
# mouser_mosScrapper.py
MOUSER_SEARCH_API_KEY=
