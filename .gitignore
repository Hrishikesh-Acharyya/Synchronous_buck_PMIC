# OS generated files
.DS_Store
Thumbs.db
Desktop.ini

# VS Code workspace files
.vscode/
*.code-workspace

/literature_review
# RTL simulation artifacts
*.vcd
*.fst
sim/supervisor_tb


# ---------------------------------------------------------------------------
# Quartus Prime build artifacts
# Only .qpf, .qsf and .sdc are tracked; everything else regenerates on compile.
# ---------------------------------------------------------------------------
quartus/db/
quartus/incremental_db/
quartus/output_files/
quartus/simulation/
quartus/greybox_tmp/
quartus/.qsys_edit/
quartus/*.qws
quartus/*.rpt
quartus/*.summary
quartus/*.pin
quartus/*.sof
quartus/*.pof
quartus/*.jdi
quartus/*.qdf
quartus/*.done
quartus/*.smsg
quartus/*.bak
quartus/*.qar
quartus/*.sopcinfo

# Simulation outputs
sim/*.out
sim/*.vcd
sim/obj_dir/
sim/work/
sim/transcript
sim/*.wlf

# Editor and tool backup files, anywhere in the tree
*.bak
# Local Vivado projects (regenerate from fpga/ + rtl/)
vivado/

# Full yosys logs of the liberty-mapped run; the summary is committed instead
Build/area.txt
Build/area_notel.txt
# Staging trees of make split / make verilog_notel; regenerated on every run
Build/split_raw/
Build/split_raw_notel/
Build/rtl-verilog-notel/
# Left behind by the retired make package (Silicluster flow); make clean removes them
Build/package_raw/
Build/package_raw_trimmed/
# make convert_notel output; regenerated from Build/pmic_full.v on demand
Build/pmic_full_notel.v
# Bundles from make bundle / bundle_notel; regenerated on demand
Build/*.zip
# Place and route, for when it is redone: fetched platform files and run outputs
pnr/platform/
pnr/work/


sim_build/
results.xml
__pycache__/
*.fst
coverage.dat

# cocotb host_if testbench (tb/telemetry/host_if). Per-run output is kept on
# disk but not tracked: random_seeds' coverage in cov/, a soak's per-run logs,
# event CSVs and coverage in soak/raw/. Only a soak's evidence is tracked:
# soak/README.md, results.txt, summary.txt, all_events.csv, merged.dat.
tb/telemetry/host_if/cov/
tb/telemetry/host_if/soak/*
!tb/telemetry/host_if/soak/README.md
!tb/telemetry/host_if/soak/results.txt
!tb/telemetry/host_if/soak/summary.txt
!tb/telemetry/host_if/soak/all_events.csv
!tb/telemetry/host_if/soak/merged.dat
# per-run files that older MAKEFILE versions wrote next to the testbench
tb/telemetry/host_if/cov_run*.dat
tb/telemetry/host_if/merged.dat
